rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        /*
         * ПОЛЬЗОВАТЕЛИ
         */

        match /users/{userId} {

            allow read:
                if request.auth != null
                && request.auth.uid == userId;

            allow create:
                if request.auth != null
                && request.auth.uid == userId;

            allow update:
                if request.auth != null
                && request.auth.uid == userId;

        }


        /*
         * ЗАКАЗЫ
         */

        match /orders/{orderId} {

            /*
             * Клиент может создать свой заказ.
             */

            allow create:
                if request.auth != null
                && request.resource.data.userId
                   == request.auth.uid;


            /*
             * Клиент может читать только
             * свои заказы.
             */

            allow read:
                if request.auth != null
                && resource.data.userId
                   == request.auth.uid;


            /*
             * Обновлять заказ клиенту запрещено.
             */

            allow update, delete:
                if false;

        }

    }

}
