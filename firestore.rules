rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function admin() { return signedIn() && me().role == "admin"; }
    function employee() { return signedIn() && me().role == "employee"; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || admin());
    }
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    match /pvz/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin() || (employee() && resource.data.pvzId == me().pvzId));
      allow update: if admin() || (employee() && resource.data.pvzId == me().pvzId);
    }
  }
}