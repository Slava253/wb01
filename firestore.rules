rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Пользователи: чтение — авторизованным, запись — только своим документом
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Товары: чтение — всем авторизованным, запись — только админам
    match /products/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ПВЗ: чтение — всем авторизованным, запись — только админам
    match /pvz/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Заказы: клиент создаёт свои, читает свои; сотрудник читает заказы своего ПВЗ
    match /orders/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
  }
}
