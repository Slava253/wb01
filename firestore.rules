rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        match /users/{userId} {

            allow read, write: if true;

        }


        match /orders/{orderId} {

            allow read, write: if true;

        }


        match /pvz/{pvzId} {

            allow read, write: if true;

        }


        match /pvzEmployees/{employeeId} {

            allow read, write: if true;

        }

    }

}
